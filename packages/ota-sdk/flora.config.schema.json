{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flora native OTA and export configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ota", "export"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ota": {
      "type": "object", "additionalProperties": false,
      "required": ["runtimeVersion", "platforms", "url"],
      "properties": {
        "runtimeVersion": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
        "platforms": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["ios", "android"] } },
        "url": { "type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://[^/@?#]+/updates/[a-z][a-z0-9_-]{2,95}$" }
      }
    },
    "export": {
      "type": "object", "additionalProperties": false,
      "required": ["bundler", "entryFile", "nodeVersion", "packageManager"],
      "properties": {
        "bundler": { "enum": ["metro", "expo"] },
        "entryFile": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$" },
        "nodeVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "packageManager": {
          "type": "object", "additionalProperties": false, "required": ["name", "version"],
          "properties": { "name": { "enum": ["npm", "pnpm", "yarn"] }, "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" } }
        }
      }
    }
  }
}
